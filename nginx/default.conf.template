# Manager reverse proxy - HTTP (and optional redirect to HTTPS).
# SSL block is in ssl.conf when Let's Encrypt is used.

log_format debug '$remote_addr - $scheme $host "$request" $status $body_bytes_sent '
                 '"$upstream_addr" rt=$request_time uat="$upstream_response_time" '
                 '"$http_referer" "$http_user_agent"';

server {
    listen ${NGINX_HTTP_PORT} default_server;
    server_name _ ${MANAGER_PUBLIC_HOST};

    access_log /dev/stdout debug;
    error_log /dev/stderr info;

    # Let's Encrypt HTTP-01 challenge (for cert issuance and renewal)
    location /.well-known/acme-challenge/ {
        alias /var/www/certbot/;
    }

    location = /hello {
        default_type text/html;
        alias /usr/share/nginx/html/hello.html;
    }

    location / {
        include /etc/nginx/snippets/root_action.conf;
    }
}
