# ============================================================
# Development Environment Template
# ============================================================
# Copy this file to manager/backend/.env.dev
# This file is used when running the manager locally in development mode
# HytaleServer runs in Docker container, manager runs locally
# ============================================================

# ====================
# Development Mode
# ====================
# This file enables development mode detection
# Backend will use Docker API to communicate with HytaleServer container

# ====================
# Docker Configuration
# ====================
# Container name for HytaleServer in dev mode
# Default: hytale-dev (or ${STACK_NAME}-dev)
GAME_CONTAINER_NAME=hytale-dev

# Stack name (used if GAME_CONTAINER_NAME not set)
STACK_NAME=hytale

# ====================
# Security (Development)
# ====================
# Less strict security for development
SECURITY_MODE=warn

# JWT Secret (generate with: openssl rand -base64 48)
# For dev, you can use a simple secret, but change it in production!
JWT_SECRET=dev-secret-key-change-in-production-min-32-characters-long

# CORS Origins (Vite dev server runs on port 5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:18080

# ====================
# Manager Authentication (Pre-Setup)
# ====================
# Only used before setup wizard completes
# After setup, authentication uses users.json
MANAGER_USERNAME=admin
MANAGER_PASSWORD=admin123

HYTALE_CONTAINER_SERVER_PATH=/opt/hytale/server
HYTALE_CONTAINER_BACKUPS_PATH=/opt/hytale/backups
HYTALE_CONTAINER_DATA_PATH=/opt/hytale/data
HYTALE_CONTAINER_MODS_PATH=/opt/hytale/mods
HYTALE_CONTAINER_ASSETS_PATH=/opt/hytale/assets

HYTALE_DOWNLOADER_URL=https://downloader.hytale.com/hytale-downloader.zip

# Host data path (for reference/error messages)
HOST_DATA_PATH=C:/Users/ermat/Projets/ermatpanel/hytale-server/manager

# ====================
# Server Configuration
# ====================
SERVER_PORT=5520
MANAGER_PORT=18080

# WebMap ports (for display)
WEBMAP_PORT=18081
WEBMAP_WS_PORT=18082

# ====================
# Network
# ====================
# Reverse proxy (usually false in dev)
TRUST_PROXY=false

# ====================
# Timezone
# ====================
TZ=Europe/Berlin

# ====================
# Optional Integrations
# ====================
# Modtale API (optional)
MODTALE_API_KEY=

# StackMart API (optional)
STACKMART_API_KEY=

# ====================
# Demo Mode
# ====================
# Set to true to run without real Hytale server (mock data)
DEMO_MODE=false
