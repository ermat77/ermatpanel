# Authentication (REQUIRED - only used before setup completes)
MANAGER_USERNAME=your_admin_username
MANAGER_PASSWORD=your_secure_password_min_12_chars
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# CORS Configuration (REQUIRED)
CORS_ORIGINS=https://localhost:18080

# Security Mode
SECURITY_MODE=strict

# Reverse Proxy
TRUST_PROXY=false

# Container Configuration
GAME_CONTAINER_NAME=hytale
STACK_NAME=hytale

# Ports
MANAGER_PORT=18080
SERVER_PORT=5520
WEBMAP_PORT=18081
WEBMAP_WS_PORT=18082

# Container Paths (inside Hytale server container)
HYTALE_CONTAINER_SERVER_PATH=/opt/hytale/server
HYTALE_CONTAINER_BACKUPS_PATH=/opt/hytale/backups
HYTALE_CONTAINER_DATA_PATH=/opt/hytale/data
HYTALE_CONTAINER_MODS_PATH=/opt/hytale/mods
HYTALE_CONTAINER_PLUGINS_PATH=/opt/hytale/plugins
HYTALE_CONTAINER_ASSETS_PATH=/opt/hytale/assets

# Manager Data Path
HOST_DATA_PATH=/app/data

# Timezone
TZ=Europe/Berlin

# Optional
DEMO_MODE=false
MODTALE_API_KEY=
STACKMART_API_KEY=