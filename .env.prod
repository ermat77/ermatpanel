# ============================================================
# Production Environment Template
# ============================================================
# Copy this file to manager/backend/.env
# This file is used when running the manager in production (Docker container)
# Both manager and HytaleServer run in Docker containers
# ============================================================

# ====================
# Docker Configuration
# ====================
# Container name for HytaleServer
# Default: hytale (or ${STACK_NAME})
GAME_CONTAINER_NAME=hytale

# Stack name (used if GAME_CONTAINER_NAME not set)
STACK_NAME=hytale

# ====================
# Security (Production)
# ====================
# STRICT MODE: Server will not start without secure configuration
SECURITY_MODE=strict

# JWT Secret (REQUIRED - min. 32 characters)
# Generate with: openssl rand -base64 48
# IMPORTANT: Change this to a secure random value!
JWT_SECRET=

# CORS Origins (REQUIRED)
# Set to your production domain(s)
# Examples:
#   Single domain: https://panel.example.com
#   Multiple: https://panel.example.com,https://admin.example.com
#   DO NOT use * in production!
CORS_ORIGINS=

# ====================
# Manager Authentication (Pre-Setup)
# ====================
# Only used before setup wizard completes
# After setup, authentication uses users.json
# IMPORTANT: Change these values!
MANAGER_USERNAME=admin
MANAGER_PASSWORD=

# ====================
# Paths (Container Paths)
# ====================
# These are paths INSIDE the Docker container
# In production, backend has direct filesystem access via volume mounts
SERVER_PATH=/opt/hytale/server
BACKUPS_PATH=/opt/hytale/backups
DATA_PATH=/opt/hytale/data
MODS_PATH=/opt/hytale/mods
ASSETS_PATH=/opt/hytale/assets

# Host data path (for reference/error messages)
# This is the path on the HOST where data is stored
HOST_DATA_PATH=/opt/hytale

# ====================
# Server Configuration
# ====================
SERVER_PORT=5520
MANAGER_PORT=18080

# WebMap ports (for display)
WEBMAP_PORT=18081
WEBMAP_WS_PORT=18082

# ====================
# Network
# ====================
# Set to true if behind reverse proxy (nginx, traefik, etc.)
TRUST_PROXY=false

# ====================
# Timezone
# ====================
TZ=Europe/Berlin

# ====================
# Optional Integrations
# ====================
# Modtale API (optional)
MODTALE_API_KEY=

# StackMart API (optional)
STACKMART_API_KEY=

# ====================
# Demo Mode
# ====================
# Should be false in production
DEMO_MODE=false
