# ============================================================
# Hytale Server - Environment Configuration
# ============================================================
# LOCAL: Copy this file to .env and adjust the values
# PORTAINER: Set these values directly in "Environment Variables"
#            (DO NOT upload as .env file!)
# ============================================================

# ====================
# Manager Data Path
# ====================
# Path where manager stores its own data (config.json, users.json, roles.json, etc.)
# Dev: e.g. ./manager-data or absolute path
# Prod (Docker): /app/data (manager-data volume)
MANAGER_DATA_PATH=


# ===================
# Game Container Path (optional)
# ====================
# Base path inside the game container (for display / docker cp). Subpaths are derived.
# Default: /opt/hytale/server
# GAME_CONTAINER_PATH=/opt/hytale/server

# ====================
# Stack Name (Container Names)
# ====================
# Prefix for all container and network names
# Allows running multiple instances in parallel
# Default: hytale
# Examples:
#   hytale-prod   -> Container: hytale-prod, hytale-prod-manager
#   hytale-test   -> Container: hytale-test, hytale-test-manager
STACK_NAME=hytale

# ====================
# Java / RAM
# ====================
JAVA_MIN_RAM=3G
JAVA_MAX_RAM=4G

# ====================
# Docker Resource Limits
# ====================
# IMPORTANT: DOCKER_MEMORY_LIMIT must be >= JAVA_MAX_RAM + 1G!
# Example: JAVA_MAX_RAM=6G -> DOCKER_MEMORY_LIMIT=8G
DOCKER_MEMORY_LIMIT=8G
DOCKER_CPU_LIMIT=4

# ====================
# Server
# ====================
SERVER_PORT=5520
SERVER_BIND=0.0.0.0
TZ=Europe/Berlin

# ====================
# Backups (Hytale Server Built-in)
# ====================
# WARNING: The built-in backup function of the Hytale Server currently
# creates empty 0KB .zip files. Therefore disabled by default.
# Use the Scheduler backups in the Web Manager Panel instead
# (Scheduler -> Auto Backups), which work and create .tar.gz files.
ENABLE_BACKUP=false
BACKUP_FREQUENCY=30

# ====================
# Auth Mode
# ====================
# authenticated = Online (Default)
# offline = LAN-only
AUTH_MODE=authenticated

# ============================================================
# SERVER FILES - CHOOSE ONE OPTION:
# ============================================================

# OPTION 1: Custom Download URLs
# Upload the files from your Hytale installation to your
# NAS/web server and provide the URLs here
SERVER_JAR_URL=
ASSETS_URL=

# OPTION 2: Official Hytale Downloader
# Download from: https://downloader.hytale.com/hytale-downloader.zip
# Requires OAuth2 login on first start!
USE_HYTALE_DOWNLOADER=false
HYTALE_PATCHLINE=release

# ====================
# Auto-Update
# ====================
# Search for updates on every container restart
# Only works with USE_HYTALE_DOWNLOADER=true
AUTO_UPDATE=false

# ============================================================
# WEB MANAGER - Server Management
# ============================================================
# Accessible at: http://localhost:18080
#
# IMPORTANT: The following variables MUST be set!
# The panel will not start in strict mode without secure configuration.

# ====================
# Manager Login (REQUIRED)
# ====================
# Username for admin login
MANAGER_USERNAME=admin
# Secure password (at least 12 characters recommended)
MANAGER_PASSWORD=dein-sicheres-passwort-min-12-zeichen

# ====================
# JWT Security (REQUIRED)
# ====================
# Generate a random string (min. 32 characters required)
# Command: openssl rand -base64 48
JWT_SECRET=

# ====================
# CORS Configuration (REQUIRED)
# ====================
# Allowed origins for API access
# When using the nginx service: set to the public URL(s) users use (e.g. http://panel.example.com, http://192.168.1.10). No trailing slash.
# Examples:
#   Local access:        http://localhost:18080
#   Domain with HTTPS:   https://panel.example.com
#   Multiple origins:    https://panel.example.com,https://admin.example.com
#   Allow all:           * (ONLY for closed networks!)
CORS_ORIGINS=http://localhost:18080

# ====================
# Security Mode
# ====================
# strict (Default): Server will not start without secure configuration
# warn: Server starts with warnings (ONLY for closed networks!)
SECURITY_MODE=strict

# ====================
# Manager Port
# ====================
MANAGER_PORT=18080

# ====================
# Reverse Proxy
# ====================
# Set to true if the manager runs behind a reverse proxy (including the nginx service below).
# When using nginx: set TRUST_PROXY=true and set CORS_ORIGINS to the public URL(s) (e.g. http://panel.example.com, http://192.168.1.10).
# Enables correct processing of X-Forwarded-* headers
TRUST_PROXY=false

# ============================================================
# NGINX REVERSE PROXY (Optional)
# ============================================================
# Use the nginx service to expose the manager frontend at a configurable URL (domain or IP).
# When using nginx, set TRUST_PROXY=true and CORS_ORIGINS to the public URL(s) above.

# ====================
# Manager Public Host
# ====================
# Domain and/or IP for server_name. Space-separated for multiple. Empty or _ = accept any host (e.g. access by IP).
# Examples:
#   Domain only:   panel.example.com
#   IP only:       192.168.1.10  or  _ (any host)
#   Both:          panel.example.com 192.168.1.10
MANAGER_PUBLIC_HOST=

# ====================
# Nginx HTTP Port
# ====================
NGINX_HTTP_PORT=80

# ============================================================
# EASYWEBMAP - Live Server Map (Optional)
# ============================================================
# Mod Download: https://www.curseforge.com/hytale/mods/easywebmap
# Place EasyWebMap-xxx.jar in /opt/hytale/mods/
# The map is accessible at http://localhost:18081

# ====================
# WebMap Ports
# ====================
WEBMAP_PORT=18081
WEBMAP_WS_PORT=18082

# ============================================================
# DEMO MODE - For demonstration purposes only
# ============================================================
# Set to true to run the panel in demo mode.
# In demo mode, all data is simulated and no real Hytale server is required.
# This is useful for demonstrations, testing, or showcasing the panel.
# DEMO_MODE=true
